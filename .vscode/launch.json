    "version": "0.2.0",
    "configurations": [

        {
            "name": "Demo Game",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/test/demos/demoGame.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/test/demos"
        },
        
        {
            "name": "Test Graphics",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/test/testGraphics.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/test"
        },

        {
            "name": "Run Game",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/Game/game.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/Game"
        }
    ]
}